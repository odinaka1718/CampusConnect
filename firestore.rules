rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to verify Nile University email
    function hasNileUniversityEmail() {
      return isAuthenticated() && 
             request.auth.token.email.matches('.*@nileuniversity\\.edu\\.ng$');
    }
    
    // Users collection
    match /users/{userId} {
      // Anyone authenticated can read user profiles
      allow read: if isAuthenticated();
      
      // Users can only create/update their own profile
      allow create: if isOwner(userId) && hasNileUniversityEmail();
      allow update: if isOwner(userId);
      
      // No one can delete user profiles (admin only via console)
      allow delete: if false;
    }
    
    // Posts collection
    match /posts/{postId} {
      // Authenticated users can read visible posts
      allow read: if isAuthenticated() && resource.data.is_visible == true;
      
      // Authors can read their own posts even if hidden
      allow read: if isOwner(resource.data.author_id);
      
      // Authenticated users can create posts
      allow create: if isAuthenticated() && 
                       request.resource.data.author_id == request.auth.uid &&
                       request.resource.data.is_visible == true &&
                       request.resource.data.report_count == 0;
      
      // Authors can update their own posts (but not report_count or is_visible)
      allow update: if isOwner(resource.data.author_id) &&
                       request.resource.data.report_count == resource.data.report_count &&
                       request.resource.data.is_visible == resource.data.is_visible;
      
      // Allow incrementing likes_count and comments_count by any authenticated user
      allow update: if isAuthenticated() &&
                       request.resource.data.content == resource.data.content &&
                       request.resource.data.author_id == resource.data.author_id;
      
      // No client-side deletion (admin only)
      allow delete: if false;
      
      // Likes subcollection
      match /likes/{likeId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if false;
      }
      
      // Comments subcollection
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && 
                         request.resource.data.author_id == request.auth.uid;
        allow update: if isOwner(resource.data.author_id);
        allow delete: if false;
      }
    }
    
    // Reports collection
    match /reports/{reportId} {
      // Only authenticated users can create reports
      allow create: if isAuthenticated() && 
                       request.resource.data.reporter_id == request.auth.uid;
      
      // Users can read their own reports
      allow read: if isOwner(resource.data.reporter_id);
      
      // No updates or deletes from client
      allow update, delete: if false;
    }
    
    // Trending collection (read-only for clients)
    match /trending/{trendId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only Cloud Functions can write
    }
  }
}
